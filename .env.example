# ─────────────────────────────────────────────────────────────
#  AI Daily News Digest — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Gmail SMTP ────────────────────────────────────────────────
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password   # NOT your regular password
RECIPIENT_EMAIL=your@gmail.com               # Who receives the digest

# ── YouTube Data API v3 ───────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Digest Schedule ───────────────────────────────────────────
DIGEST_TIME=07:00                            # 24h format, e.g. "07:00" or "19:30"
DIGEST_TIMEZONE=Asia/Jerusalem               # Your local timezone (IANA format)

# ── Collection Settings ───────────────────────────────────────
RSS_MAX_AGE_HOURS=24                         # Only fetch articles from last N hours
BLOG_MAX_AGE_HOURS=72                        # Blogs post less frequently, wider window
YOUTUBE_MAX_RESULTS=5                        # Max videos per channel to fetch
HN_TOP_STORIES_LIMIT=30                      # Number of HN stories to fetch
